{
  "expo": {
    "name": "Pharm36",
    "slug": "Pharm36",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060A0C",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060A0C",
        "foregroundImage": "./assets/images/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pharm36 uses the camera to scan medicine barcodes."
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#060A0C",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ]
  }
}
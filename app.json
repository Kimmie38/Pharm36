{
  "expo": {
    "name": "Pharm36",
    "slug": "pharm36",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060A0C",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060A0C",
        "foregroundImage": "./assets/images/logo.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.pharm36"
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pharm36 uses the camera to scan medicine barcodes."
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#060A0C",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3aa30906-1825-408d-adac-5d85125592cc"
      }
    },
    "owner": "pharm36"
  }
}
